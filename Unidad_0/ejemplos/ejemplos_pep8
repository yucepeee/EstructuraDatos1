def calculate_area(base, height):
    """Calcula el área de un rectángulo a partir de su base y altura.

    Parameters:
        base (int o float): Longitud de la base.
        height (int o float): Longitud de la altura.

    Returns:
        float: Área total del rectángulo.
    """
    area = base * height
    return area


if __name__ == "__main__":
  #Llamada al metodo calculate_area
    rect_area = calculate_area(10, 5)
    print(f"El área del rectángulo es: {rect_area}")

