def is_even(numero):
    """Determina si un número entero es par o impar.

    Args:
        numero (int): El número entero a evaluar.

    Returns:
        bool: True si el número es par, False si es impar.
    """
    return numero % 2 == 0


if __name__ == "__main__":
  #Llamada al metodo is_even
    num = 8
    if is_even(num):
        print(f"El número {num} es par.")
    else:
        print(f"El número {num} es impar.")

